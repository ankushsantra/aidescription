<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="ankush_aiagent"
           resource="default"
           engine="innodb"
           comment="Ankush AI Agent Table">

        <column xsi:type="int"
                name="id"
                padding="10"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="ID"/>

        <column xsi:type="text"
                name="agent_title"
                nullable="false"
                comment="Agent Title"/>

        <column xsi:type="text"
                name="agent_details"
                nullable="false"
                comment="Agent Details"/>

        <column xsi:type="smallint"
                name="status"
                unsigned="false"
                nullable="false"
                default="0"
                comment="Status"/>

        <column xsi:type="timestamp"
                name="created_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp"
                name="updated_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                on_update="true"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

    </table>

</schema>
